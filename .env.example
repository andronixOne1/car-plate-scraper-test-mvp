# Server Configuration
PORT=10000

# Firebase Storage Bucket Name (e.g., your-project.appspot.com or your-project.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=your-firebase-project.appspot.com

# Firebase Credentials Options:
# Option A: Local path to service account JSON
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Option B: Inline JSON string (recommended for Render environment variables)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
